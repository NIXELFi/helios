<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helios Vault — SOLIDWORKS add-in (Phase 1 skeleton).
    .NET Framework 4.8 COM add-in, x64 (SOLIDWORKS is 64-bit). Self-registers
    for COM via the [ComRegisterFunction] hooks in SwAddin.cs (run `regasm
    /codebase`). See README.md for build + register steps.

    The SOLIDWORKS interop assemblies are referenced from your local SW install.
    Override the path if yours differs:
        dotnet build -c Release -p:SolidWorksApiPath="D:\...\api\redist"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>HeliosVault</RootNamespace>
    <AssemblyName>HeliosVault</AssemblyName>
    <!-- Assembly is NOT COM-visible by default; only the SwAddin class opts in. -->
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SolidWorksApiPath Condition="'$(SolidWorksApiPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Build-only: supplies the .NET Framework 4.8 reference assemblies so the
      project builds with the `dotnet` SDK without the system-wide Developer
      Pack installed. PrivateAssets=all => build-time only, nothing extra ships.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assemblies for the localhost bridge client (HeliosBridge.cs):
         HttpClient + the built-in JSON (de)serializer. Both ship with .NET
         Framework 4.8, so nothing extra is deployed next to the add-in. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
