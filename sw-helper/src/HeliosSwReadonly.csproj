<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helios SW read-only helper.

    A tiny out-of-process console exe the Helios desktop app spawns on
    check-out / check-in to flip a SOLIDWORKS document's in-session read-only
    state — the one thing the on-disk read-only bit can't do while a file is
    already open. This makes "check out → editable" / "check in → read-only"
    work WITHOUT the SOLIDWORKS add-in installed (or if it's broken / disabled):
    the add-in becomes a nicety, not a requirement.

    Connects to the running SOLIDWORKS via COM automation (no in-process add-in),
    finds the open doc by path, and calls IModelDoc2.SetReadOnlyState — the same
    API the add-in uses. No-op if SOLIDWORKS isn't running or the file isn't
    open. x64 to match SOLIDWORKS; EmbedInteropTypes so nothing ships beside it.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>HeliosSwReadonly</RootNamespace>
    <AssemblyName>HeliosSwReadonly</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- No console window flashes: the desktop spawns it hidden, but mark it so
         even a manual run is quiet. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <SolidWorksApiPath Condition="'$(SolidWorksApiPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
