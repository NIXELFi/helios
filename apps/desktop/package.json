{
  "name": "@helios/desktop",
  "version": "4.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:addin": "dotnet build -c Release ../../solidworks-addin/src && node -e \"const fs=require('fs');fs.mkdirSync('src-tauri/resources/addin',{recursive:true});fs.copyFileSync('../../solidworks-addin/src/bin/Release/net48/HeliosVault.dll','src-tauri/resources/addin/HeliosVault.dll')\"",
    "build:shell": "dotnet build -c Release ../../shell-ext/src && node -e \"const fs=require('fs');fs.mkdirSync('src-tauri/resources/shell',{recursive:true});for(const f of ['HeliosShell.dll','SharpShell.dll'])fs.copyFileSync('../../shell-ext/src/bin/Release/net48/'+f,'src-tauri/resources/shell/'+f)\"",
    "build:swhelper": "dotnet build -c Release ../../sw-helper/src && node -e \"const fs=require('fs');fs.mkdirSync('src-tauri/resources/swhelper',{recursive:true});fs.copyFileSync('../../sw-helper/src/bin/Release/net48/HeliosSwReadonly.exe','src-tauri/resources/swhelper/HeliosSwReadonly.exe')\"",
    "build:win": "pnpm build:addin && pnpm build:shell && pnpm build:swhelper && pnpm tauri build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@helios/auth": "workspace:*",
    "@helios/lib": "workspace:*",
    "@helios/pm-ui": "workspace:*",
    "@helios/store": "workspace:*",
    "@helios/ui": "workspace:*",
    "@helios/widgets": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@tabler/icons-react": "^3.17.0",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@xyflow/react": "^12.3.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "pako": "^2.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "uplot": "^1.6.30",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^25.6.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
