{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helios",
  "version": "3.5.4",
  "identifier": "edu.asu.sdm.helios",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Helios",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https:; worker-src 'self' blob:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../../samples/sdm26-synthetic-lap.csv": "samples/sdm26-synthetic-lap.csv",
      "../../../samples/sdm26-synthetic-multi-lap.csv": "samples/sdm26-synthetic-multi-lap.csv",
      "../../../SDM26-5-3-Best_Accel.csv": "samples/sdm26-best-accel.csv",
      "../../../driver_tryout_4_16__57_kaden_good_gps.csv": "samples/driver-tryout-good-gps.csv",
      "../../../docs/channels.yaml": "channels.yaml",
      "resources/cfd/configs/sdm25.json": "cfd/configs/sdm25.json",
      "resources/cfd/configs/sdm26.json": "cfd/configs/sdm26.json"
    },
    "fileAssociations": [
      {
        "ext": [
          "helios"
        ],
        "name": "Helios workspace bundle",
        "description": "Helios workspace bundle (shareable JSON of one or more workspaces)",
        "role": "Editor",
        "mimeType": "application/x-helios-bundle"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/NIXELFi/helios/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3QTdDN0I4MzU1Qzg1OEYKUldTUGhWdzF1TWVudDEzcjJ0V0gzUUtrWkRmUzhVSElmYW1VMWZVK040cno4MUljMy84WlRKamsK"
    }
  }
}
