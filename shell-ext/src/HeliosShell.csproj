<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helios Shell — Windows Explorer integration for the Helios vault.

    A .NET Framework 4.8 COM in-proc server hosting Explorer shell extensions
    (context menu, icon overlays, info-tips) built on SharpShell. It's a thin
    client of the same localhost bridge the SOLIDWORKS add-in uses
    (%LOCALAPPDATA%\Helios\bridge.json) plus the bridge-written state cache
    (%LOCALAPPDATA%\Helios\shell-state.json) — so Explorer, the desktop app, and
    SOLIDWORKS all reflect the same vault state.

    x64 because Explorer (explorer.exe) is 64-bit. Self-registers via the Helios
    injector (per-user CLSID + the shell-extension reg keys), mirroring the SW
    add-in — no RegAsm/srm needed in production.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>HeliosShell</RootNamespace>
    <AssemblyName>HeliosShell</AssemblyName>
    <!-- AssemblyVersion constant so COM "Assembly" bindings don't churn;
         FileVersion is bumped per change and is what the injector compares to
         decide whether to re-stage. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Version>1.0.1.0</Version>
    <!-- Only the specific handler classes opt into COM visibility. -->
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- SharpShell + our handlers register themselves; suppress the SDK's COM
         hosting machinery (we do classic regasm-style CLSID keys ourselves). -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time .NET Framework 4.8 reference assemblies, so this builds with
         the `dotnet` SDK without the system Developer Pack. Build-only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- SharpShell: managed base classes + COM plumbing for shell extensions. -->
    <PackageReference Include="SharpShell" Version="2.7.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bridge client (HttpClient + the built-in JSON serializer), both ship
         with .NET Framework 4.8 so nothing extra deploys next to the DLL. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
