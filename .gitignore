# Node
node_modules/
.turbo/
dist/
*.log

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Helios bundle exports — never commit user-saved workspace bundles
*.helios
helios-workspaces.json
helios-workspace-*.json

# Env — catch every flavor of dotenv except committed examples.
# `!.env.example` ensures `cp .env.example .env` workflows still ship the
# template in git.
.env
.env.local
.env.production
.env.staging
.env.*.local
.env.*
!.env.example

# Test artifacts
coverage/
playwright-report/
test-results/

# Supabase local secrets
infra/pdm-supabase/.env
