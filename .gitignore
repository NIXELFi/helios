# Node
node_modules/
.turbo/
dist/
*.log

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Helios bundle exports — never commit user-saved workspace bundles
*.helios
helios-workspaces.json
helios-workspace-*.json

# Env — catch every flavor of dotenv except committed examples.
# `!.env.example` ensures `cp .env.example .env` workflows still ship the
# template in git.
.env
.env.local
.env.production
.env.staging
.env.*.local
.env.*
!.env.example

# Test artifacts
coverage/
playwright-report/
test-results/

# Supabase local secrets
infra/pdm-supabase/.env

# Local Claude config
.claude/

# Local audit workspace — findings reports + fix trackers. Kept in-repo for
# convenience but never committed (this is a public repo).
.audit/

# CFD capture artifacts written by the runner — per-job sweep outputs
# (P-V, profiles, wave frames). Reproducible by re-running the sweep;
# can reach multi-GB and must not be committed.
/cfd/

# Physics agent isolation (spec C2/C3) — worktrees, transient lock state,
# in-flight amendment proposals. The worktrees/.gitkeep is tracked so the
# dir exists even when no agents are active.
worktrees/agent-*/
.physics_locks/_orchestrator.mutex
.physics_locks/_orchestrator.mutex_dir/
worktrees/agent-*/pending_amend.json
worktrees/agent-*/pending_amend.rejected.json

# Physics agent scratch space (smoke outputs, ad-hoc sweep results)
/tmp/

# NOTE: apps/desktop/src-tauri/resources/addin/HeliosVault.dll is committed
# (prebuilt) so the Helios bundle can include the SOLIDWORKS add-in without the
# .NET toolchain on the build machine. Rebuild + recommit it after add-in changes
# via `pnpm --filter @helios/desktop build:addin`.
